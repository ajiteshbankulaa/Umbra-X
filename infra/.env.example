# Copy to .env before running docker compose up
# Required >= 24 characters when binding API to 0.0.0.0
UMBRA_API_TOKEN=replace-with-random-32-char-bearer-secret
UMBRA_PG_PASSWORD=replace-with-local-postgres-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-password

# Optional external OpenAI-compatible reasoning endpoint (HTTPS required for remote hosts)
UMBRA_MODEL_URL=
UMBRA_MODEL=
UMBRA_MODEL_KEY=
