FROM python:3.12-slim
WORKDIR /app
COPY pipeline/pyproject.toml pipeline/pyproject.toml
COPY pipeline/umbra_x pipeline/umbra_x
RUN pip install --no-cache-dir ./pipeline
COPY pipeline/live_terrain.py pipeline/terrain_server.py pipeline/
COPY pipeline/cache/LDEM_80S_80MPP_ADJ.TIF /data/terrain.tif
ENV UMBRA_TERRAIN_TIF=/data/terrain.tif UMBRA_HOST=0.0.0.0 PORT=8080 NUMBA_CACHE_DIR=/tmp/numba
USER 65532:65532
CMD ["python", "pipeline/terrain_server.py"]
