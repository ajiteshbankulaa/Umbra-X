# Multi-stage static frontend + immutable versioned NASA binary asset host
FROM node:24.11.0-bookworm-slim AS builder
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY web/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY --chown=nginx:nginx infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chown=nginx:nginx --from=builder /app/web/dist /usr/share/nginx/html

USER nginx
EXPOSE 8080
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=20s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz-static || exit 1
