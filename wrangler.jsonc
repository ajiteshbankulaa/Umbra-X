{
  "$schema": "web/node_modules/wrangler/config-schema.json",
  "name": "umbra-x",
  "main": "web/worker.js",
  "compatibility_date": "2026-11-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/readyz"]
  }
}
