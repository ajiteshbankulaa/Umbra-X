    {
      "id": "e01_delay_recovery_compare",
      "category": "constraint_comparison",
      "question": "Why does this launch delay improve Earth visibility but not recover the mission?",
      "context": {
        "scenarios": [
          { "site": "shackleton-ridge", "node": 480, "start": 0, "mast": 2 },
          { "site": "shackleton-ridge", "node": 480, "start": 48, "mast": 2 }
        ],
        "days": 15,
        "limits": { "dark": 48, "earth": 72, "slope": 5 }
      },
      "expectedStatus": "answered",
      "expectedTools": ["inspect_coverage", "compare_scenarios"],
      "expectedNumbers": [103.67, 55.67, 52.25, 5.6],
      "expectedDocIds": ["umbrax-mission-recovery", "umbrax-uncertainty-limitations", "ntrs-lunar-site-selection-2023", "ntrs-mazarico-2011"]
